{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tysongreenan/tastetest/docs/findings.schema.json",
  "title": "Panel structured findings",
  "type": "object",
  "required": ["schemaVersion", "surface", "findings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "confidence",
          "surface",
          "problem",
          "evidence",
          "change",
          "personaImpact",
          "acceptanceCheck",
          "owner",
          "sourceArtifacts",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(H|F)-[0-9]{3,}$" },
          "severity": { "enum": ["Block", "P0", "P1", "P2"] },
          "confidence": { "enum": ["observed", "strong-inference", "speculative"] },
          "surface": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "ref", "claim"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["browser", "file", "user-data", "analytics", "test"] },
                "ref": { "type": "string", "minLength": 1 },
                "claim": { "type": "string", "minLength": 1 }
              }
            }
          },
          "change": { "type": "string", "minLength": 1 },
          "personaImpact": {
            "type": "object",
            "required": ["priority", "secondary"],
            "additionalProperties": false,
            "properties": {
              "priority": { "type": "string", "minLength": 1 },
              "secondary": { "type": "string", "minLength": 1 }
            }
          },
          "acceptanceCheck": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "sourceArtifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["open", "approved", "implemented", "verified", "deferred", "rejected"] }
        }
      }
    }
  }
}
